{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gui-pi-desktop",
  "version": "0.3.0",
  "identifier": "io.github.cszf1.gui-pi-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gui-pi",
        "width": 900,
        "height": 680,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../dist/resources/": "resources/"
    },
    "linux": {
      "deb": {
        "depends": [
          "at-spi2-core",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  }
}
